create-workspace.sh|3|1||||normal|||moduleheader|SolidGroundUX SDK - Create Workspace|create-workspace.sh::::
create-workspace.sh|14|2||||label|||modulebody|Description|create-workspace.sh::::
create-workspace.sh|15|3||||normal|||modulebody|  Provides a developer utility that scaffolds a new project workspace|create-workspace.sh::::
create-workspace.sh|16|4||||normal|||modulebody|  into a target directory using the framework's standard template layout.|create-workspace.sh::::
create-workspace.sh|17|5||||normal|||modulebody||create-workspace.sh::::
create-workspace.sh|18|6||||label|||modulebody|The script|create-workspace.sh::::
create-workspace.sh|19|7||||normal|||modulebody|    - Resolves project name and target folder|create-workspace.sh::::
create-workspace.sh|20|8||||normal|||modulebody|    - Creates a repository-shaped target-root structure|create-workspace.sh::::
create-workspace.sh|21|9||||normal|||modulebody|    - Lists installed convenience templates and lets the user choose which to copy|create-workspace.sh::::
create-workspace.sh|22|10||||normal|||modulebody|    - Copies the selected convenience templates into the new project workspace|create-workspace.sh::::
create-workspace.sh|23|11||||normal|||modulebody|    - Creates project-namespaced definitions in the SolidGroundUX globals folder|create-workspace.sh::::
create-workspace.sh|24|12||||normal|||modulebody|    - Optionally creates a simple 95-<project> MOTD identity entry|create-workspace.sh::::
create-workspace.sh|25|13||||normal|||modulebody|    - Generates a VS Code workspace file and standard .gitignore and .release-ignore|create-workspace.sh::::
create-workspace.sh|26|14||||normal|||modulebody|    - Optionally initializes Git and creates/pushes a GitHub repository using gh|create-workspace.sh::::
create-workspace.sh|27|15||||normal|||modulebody||create-workspace.sh::::
create-workspace.sh|28|16||||label|||modulebody|Design principles|create-workspace.sh::::
create-workspace.sh|29|17||||normal|||modulebody|  - Workspace creation is deterministic and repeatable|create-workspace.sh::::
create-workspace.sh|30|18||||normal|||modulebody|  - Follows SolidGroundUX project conventions|create-workspace.sh::::
create-workspace.sh|31|19||||normal|||modulebody|  - Supports dry-run for all filesystem operations|create-workspace.sh::::
create-workspace.sh|32|20||||normal|||modulebody||create-workspace.sh::::
create-workspace.sh|33|21||||label|||modulebody|Role in framework|create-workspace.sh::::
create-workspace.sh|34|22||||normal|||modulebody|  - Entry point for initializing new development workspaces|create-workspace.sh::::
create-workspace.sh|35|23||||normal|||modulebody|  - Ensures consistent project structure across environments|create-workspace.sh::::
create-workspace.sh|36|24||||normal|||modulebody||create-workspace.sh::::
create-workspace.sh|37|25||||label|||modulebody|Non-goals|create-workspace.sh::::
create-workspace.sh|38|26||||normal|||modulebody|  - Deployment or installation of runtime environments|create-workspace.sh::::
create-workspace.sh|39|27||||normal|||modulebody|  - Managing existing workspaces beyond initial scaffolding|create-workspace.sh::::
create-workspace.sh|40|28||||normal|||modulebody||create-workspace.sh::::
