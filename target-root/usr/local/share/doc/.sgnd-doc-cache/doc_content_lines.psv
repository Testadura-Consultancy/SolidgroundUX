sgnd-system.sh|2|1||||normal|||moduleheader|SolidGroundUX - System Utilities|sgnd-system.sh::::
sgnd-system.sh|13|2||||label|||modulebody|Description|sgnd-system.sh::::
sgnd-system.sh|14|3||||normal|||modulebody|  Contains environment-aware helpers that sit above sgnd-core.|sgnd-system.sh::::
sgnd-system.sh|15|4||||normal|||modulebody||sgnd-system.sh::::
sgnd-system.sh|16|5||||label|||modulebody|The library|sgnd-system.sh::::
sgnd-system.sh|17|6||||normal|||modulebody|    - Provides root/sudo/runtime guards|sgnd-system.sh::::
sgnd-system.sh|18|7||||normal|||modulebody|    - Exposes OS, network, and service-state helpers|sgnd-system.sh::::
sgnd-system.sh|19|8||||normal|||modulebody|    - Includes ownership and permission normalization helpers|sgnd-system.sh::::
sgnd-system.sh|20|9||||normal|||modulebody|    - Keeps operational/debug output close to procedural system actions|sgnd-system.sh::::
sgnd-system.sh|21|10||||normal|||modulebody||sgnd-system.sh::::
sgnd-system.sh|22|11||||label|||modulebody|Design principles|sgnd-system.sh::::
sgnd-system.sh|23|12||||normal|||modulebody|  - Keep system behavior out of sgnd-core|sgnd-system.sh::::
sgnd-system.sh|24|13||||normal|||modulebody|  - Depend on framework bootstrap guarantees for minimal say* functions|sgnd-system.sh::::
sgnd-system.sh|25|14||||normal|||modulebody|  - Prefer explicit operational helpers over mixing host logic into generic primitives|sgnd-system.sh::::
sgnd-system.sh|26|15||||normal|||modulebody|  - Keep behavior predictable and side effects documented|sgnd-system.sh::::
sgnd-system.sh|27|16||||normal|||modulebody||sgnd-system.sh::::
sgnd-system.sh|28|17||||label|||modulebody|Role in framework|sgnd-system.sh::::
sgnd-system.sh|29|18||||normal|||modulebody|  - System/runtime layer above sgnd-core|sgnd-system.sh::::
sgnd-system.sh|30|19||||normal|||modulebody|  - Used by installers, setup routines, and host-aware modules|sgnd-system.sh::::
sgnd-system.sh|31|20||||normal|||modulebody|  - Centralizes platform and privilege helpers|sgnd-system.sh::::
sgnd-system.sh|32|21||||normal|||modulebody||sgnd-system.sh::::
sgnd-system.sh|33|22||||label|||modulebody|Non-goals|sgnd-system.sh::::
sgnd-system.sh|34|23||||normal|||modulebody|  - Business logic or application-specific behavior|sgnd-system.sh::::
sgnd-system.sh|35|24||||normal|||modulebody|  - Interactive UI rendering or menu behavior|sgnd-system.sh::::
sgnd-system.sh|36|25||||normal|||modulebody|  - Generic string/array/text helpers (handled in sgnd-core)|sgnd-system.sh::::
sgnd-system.sh|37|26||||normal|||modulebody||sgnd-system.sh::::
